{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgamefactory.dev/schemas/artifacts/qa-report.schema.json",
  "title": "QA Report",
  "description": "Independent verification of a built release candidate.\n\nDeliberately distinct from the implement/test/fix loop an agent runs during production. An agent reporting \"ready\" and QA reporting \"approved\" are different events with different authority, and collapsing them removes the only external check on agent output. QA must be able to fail a build its author believes is finished.\n\nThe verdict is computed from blocking_defects and perf_results, not asserted.",

  "x-wgf": {
    "id": "qa-report",
    "kind": "artifact",
    "format": "json",
    "template": "templates/qa-report.md",
    "producer": "release:qa",
    "consumers": ["release:rc", "title:production"],
    "repo_path": "<game-repo>/qa/<release-id>/report.json",
    "required_for_gates": ["G5"]
  },

  "type": "object",
  "required": ["provenance", "title_id", "release_id", "build_ref", "suites", "blocking_defects", "perf_results", "verdict"],
  "properties": {
    "provenance": { "$ref": "./shared/provenance.schema.json#/$defs/provenance" },
    "title_id": { "type": "string" },
    "release_id": { "type": "string" },

    "build_ref": {
      "type": "object",
      "required": ["commit_sha"],
      "properties": {
        "commit_sha": { "type": "string" },
        "url": { "type": "string" },
        "artifact_hash": { "$ref": "./shared/provenance.schema.json#/$defs/hash" }
      },
      "additionalProperties": false
    },

    "suites": {
      "type": "array",
      "minItems": 1,
      "description": "Deterministic CI results. These are facts from a pipeline, not judgements.",
      "items": {
        "type": "object",
        "required": ["name", "passed", "failed"],
        "properties": {
          "name": { "enum": ["lint", "typecheck", "unit", "integration", "e2e", "build", "smoke", "performance", "platform-validation"] },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "run_url": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "blocking_defects": {
      "type": "array",
      "description": "Must be empty to reach RC. Non-blocking defects go in accepted_defects, where a human explicitly accepts them at G5 rather than never hearing about them.",
      "items": { "$ref": "#/$defs/defect" }
    },

    "accepted_defects": {
      "type": "array",
      "items": { "$ref": "#/$defs/defect" }
    },

    "perf_results": {
      "type": "array",
      "minItems": 1,
      "description": "Measured per device class against tech_plan.perf_budgets. Mobile web is where budgets are actually broken.",
      "items": {
        "type": "object",
        "required": ["device_class", "fps", "within_budget"],
        "properties": {
          "device_class": { "type": "string" },
          "fps": { "type": "number" },
          "memory_mb": { "type": "number" },
          "time_to_interactive_s": { "type": "number" },
          "bundle_mb": { "type": "number" },
          "within_budget": { "type": "boolean" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "browser_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["browser", "platform", "result"],
        "properties": {
          "browser": { "type": "string" },
          "platform": { "type": "string" },
          "result": { "enum": ["pass", "fail", "not-tested"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "platform_checks": {
      "type": "array",
      "description": "Per-platform functional checks: SDK init, ads, save/load, leaderboards. Distinct from the assertions run at release:validating, which check the package rather than the behaviour.",
      "items": {
        "type": "object",
        "required": ["platform_id", "result"],
        "properties": {
          "platform_id": { "type": "string" },
          "result": { "enum": ["pass", "fail", "not-tested"] },
          "checks": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "verdict": {
      "enum": ["pass", "fail"],
      "description": "pass requires blocking_defects empty AND every perf_result within budget. Derived, not asserted."
    }
  },
  "additionalProperties": false,

  "$defs": {
    "defect": {
      "type": "object",
      "required": ["id", "severity", "summary", "repro"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "enum": ["blocker", "critical", "major", "minor", "trivial"] },
        "summary": { "type": "string" },
        "repro": {
          "type": "string",
          "description": "Steps. A defect nobody can reproduce cannot be fixed or verified, only argued about."
        },
        "platform_id": { "type": "string" },
        "device_class": { "type": "string" },
        "accepted_rationale": {
          "type": "string",
          "description": "Required when a defect is accepted rather than fixed."
        }
      },
      "additionalProperties": false
    }
  }
}
