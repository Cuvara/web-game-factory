{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgamefactory.dev/schemas/artifacts/quality-report.schema.json",
  "title": "Quality report",
  "description": "The Factory quality gate's scorecard of ONE build: every quality dimension (gameplay, content sufficiency, variety, progression, visual, UI, audio, consistency, polish, technical/performance, platform readiness, store) scored from the reports the producing steps wrote about that same build - playability, production-quality, visual-qa, content-sufficiency, verify, review, sdk, and the store listing's validation once it exists - against the versioned quality contract (core/reference/quality-floor.yaml: the universal floor every game carries, the genre family's contract and the 3D contract) and the release bars of core/reference/quality-benchmark.yaml at the run's quality tier, as the run pinned them when it started. A dimension passes only at or above its floor: no average carries a dimension past a failed blocker criterion, and no dimension's score carries another's. Evidence about another commit than the build's is stale and blocks the report. Each failing criterion is a typed finding with its owner discipline and route, carried open across builds and closed only by a re-measurement on a newer build. The release decision is `release` only at the release tier with every dimension at its floor; a run at tier mvp is `development`, never release. Added in Factory 2.8.0 (WS-7). Since 1.3.0 a `compliance` section holds the build to the run's knowledge-contract: every applicable rule of core/reference/lessons.yaml with its status, cited by its producers' reports.",
  "x-wgf": {
    "id": "quality-report",
    "kind": "artifact",
    "format": "json",
    "version": "1.3.0",
    "producer": "title:prototype",
    "consumers": [
      "title:design",
      "title:prototype",
      "title:prototype-review",
      "release:draft"
    ],
    "repo_path": "<game-repo>/qa/quality/<commit>.json",
    "run_path": "<storage>/workflows/<run-id>/artifacts/quality-report/v<n>.json",
    "required_for_gates": [
      "G4"
    ]
  },
  "type": "object",
  "required": [
    "provenance",
    "title_id",
    "build",
    "quality_tier",
    "benchmark",
    "contract",
    "evidence",
    "dimensions",
    "criteria",
    "findings",
    "regression",
    "release_decision",
    "failed",
    "routes",
    "verdict"
  ],
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": [
        "artifact_type"
      ],
      "properties": {
        "artifact_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "minimum": {},
        "maximum": {},
        "preferred": {}
      },
      "additionalProperties": false
    },
    "complianceEvidence": {
      "type": [
        "object",
        "null"
      ],
      "description": "The producer's report the check was read from: its artifact id, content hash and the commit it describes - never an agent's word. `self`: this quality-report's own criteria (its content hash is its provenance's). null: the run holds no report of the producer.",
      "required": [
        "artifact_type",
        "artifact_id",
        "content_hash",
        "commit",
        "current"
      ],
      "properties": {
        "artifact_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true: the report describes this build; false: another (stale); null: the producer is not tied to a commit of the build (the design, the asset manifest)."
        },
        "self": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "complianceCount": {
      "type": "object",
      "required": [
        "applicable",
        "satisfied",
        "failed",
        "unmeasured",
        "excepted",
        "deferred",
        "not_applicable",
        "not_enforced"
      ],
      "properties": {
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unmeasured": {
          "type": "integer",
          "minimum": 0
        },
        "excepted": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "not_enforced": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "provenance": {
      "$ref": "shared/provenance.schema.json#/$defs/provenance"
    },
    "title_id": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "description": "The build every score is about: the shipped (verified) commit, the development commit it sits on (the one the play and judgement gates name), and the digest of the verified bundle (verification-report build_artifact.content_hash).",
      "required": [
        "commit",
        "development_commit",
        "digest"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "development_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "quality_tier": {
      "enum": [
        "mvp",
        "release",
        null
      ],
      "description": "The tier the build was held to: the design's build_spec.content.quality_tier, else the strategy's concept.content_model.quality_tier; null when neither states one, which is held as mvp."
    },
    "benchmark": {
      "type": "object",
      "description": "The versioned contract the scores were computed against, as the run pinned it when it started (`pinned` false: a run started before its workflow pinned references, which read the live files).",
      "required": [
        "floor",
        "quality_benchmark",
        "visual_qa_rubric",
        "pinned"
      ],
      "properties": {
        "floor": {
          "$ref": "#/$defs/pin"
        },
        "quality_benchmark": {
          "$ref": "#/$defs/pin"
        },
        "visual_qa_rubric": {
          "$ref": "#/$defs/pin"
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "description": "The contract derived for this game: the universal floor, the genre family's (or the family of its genre node's nearest ancestor) and the rendering dimension's.",
      "required": [
        "universal",
        "family",
        "genre",
        "resolved_by",
        "render"
      ],
      "properties": {
        "universal": {
          "type": "integer",
          "minimum": 0
        },
        "family": {
          "type": [
            "string",
            "null"
          ],
          "description": "The design's genre.family."
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "description": "The family whose contract applied; null when none could be resolved (the universal floor alone)."
        },
        "resolved_by": {
          "enum": [
            "family",
            "ancestor",
            "none"
          ]
        },
        "via_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "render": {
          "enum": [
            "2d",
            "3d",
            null
          ]
        },
        "criteria": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "description": "Every report the scores read, the commit it describes and the commit it had to describe. `stale`: another build's, which BLOCKS the report.",
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "status"
        ],
        "properties": {
          "artifact_type": {
            "type": "string"
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "of": {
            "enum": [
              "development",
              "shipped",
              null
            ]
          },
          "status": {
            "enum": [
              "current",
              "stale",
              "absent"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "score",
          "min_score",
          "status",
          "regression",
          "criteria",
          "owner"
        ],
        "properties": {
          "id": {
            "enum": [
              "gameplay",
              "content",
              "variety",
              "progression",
              "visual",
              "ui",
              "audio",
              "consistency",
              "polish",
              "technical",
              "platform",
              "store"
            ]
          },
          "label": {
            "type": "string"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "min_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "preferred": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "BELOW_FLOOR",
              "UNMEASURED",
              "DEFERRED"
            ]
          },
          "regression": {
            "type": "boolean",
            "description": "QUALITY REGRESSION: the dimension is below its floor under the pinned benchmark."
          },
          "previous_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "blockers_failed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "dimension",
          "severity",
          "status",
          "score",
          "owner",
          "route",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "universal",
              "genre",
              "render"
            ]
          },
          "dimension": {
            "enum": [
              "gameplay",
              "content",
              "variety",
              "progression",
              "visual",
              "ui",
              "audio",
              "consistency",
              "polish",
              "technical",
              "platform",
              "store"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "warning"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNMEASURED",
              "DEFERRED"
            ]
          },
          "observed": {},
          "expected": {
            "$ref": "#/$defs/expected"
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidenceRef"
            }
          },
          "owner": {
            "type": "string"
          },
          "route": {
            "enum": [
              "design-gap",
              "assets",
              "develop",
              "listing"
            ]
          },
          "summary": {
            "type": "string"
          },
          "scorecard": {
            "type": "string",
            "description": "Added in 1.2.0. The scorecard line the criterion names in its own `scorecard` field, when it is not its dimension's line."
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "description": "One typed finding per criterion below its minimum, and per earlier finding not yet closed: the record specialist routing reads - id, dimension, severity, evidence, the build it was measured on (commit and digest), expected threshold, observed value, owner discipline, route and status. A finding is closed only when a newer build's re-measurement meets the minimum; one that passes again on the build it was raised on stays open.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "dimension",
          "severity",
          "summary",
          "evidence",
          "build",
          "expected",
          "observed",
          "owner",
          "route",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "dimension": {
            "enum": [
              "gameplay",
              "content",
              "variety",
              "progression",
              "visual",
              "ui",
              "audio",
              "consistency",
              "polish",
              "technical",
              "platform",
              "store"
            ]
          },
          "layer": {
            "enum": [
              "universal",
              "genre",
              "render"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidenceRef"
            }
          },
          "build": {
            "type": "object",
            "required": [
              "commit",
              "digest"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "expected": {
            "$ref": "#/$defs/expected"
          },
          "observed": {},
          "owner": {
            "type": "string"
          },
          "route": {
            "enum": [
              "design-gap",
              "assets",
              "develop",
              "listing"
            ]
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "first_seen": {
            "type": [
              "string",
              "null"
            ],
            "description": "The commit the finding was first measured on."
          },
          "closed_on": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "regressed": {
            "type": "boolean",
            "description": "It met its minimum on the previous build of this run and does not on this one."
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "design_gap": {
            "type": "object",
            "required": [
              "field",
              "question",
              "severity"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "assumed": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "severity": {
                "enum": [
                  "blocking",
                  "minor"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "regression": {
      "type": "object",
      "description": "Regression against the pinned benchmark (a dimension below its floor is a QUALITY REGRESSION) and against the previous quality-report of this run.",
      "required": [
        "benchmark_version",
        "below_floor",
        "previous",
        "dropped"
      ],
      "properties": {
        "benchmark_version": {
          "type": "string"
        },
        "below_floor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "artifact_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "benchmark_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "from",
              "to"
            ],
            "properties": {
              "dimension": {
                "type": "string"
              },
              "from": {
                "type": "number"
              },
              "to": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "regressed_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "overall_score": {
      "type": [
        "number",
        "null"
      ],
      "description": "The mean of the measured dimension scores. Reported only: it decides nothing."
    },
    "release_decision": {
      "type": "object",
      "required": [
        "decision",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "release",
            "not-release",
            "development"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The dimensions below their floor."
    },
    "routes": {
      "type": "array",
      "items": {
        "enum": [
          "design-gap",
          "assets",
          "develop",
          "listing"
        ]
      },
      "description": "Where the findings that hold a dimension below its floor go back to; the step returns the first (design-gap, assets, develop, listing)."
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dimensions measured later in the run: the store, once its listing exists."
    },
    "scorecard": {
      "type": "object",
      "description": "Added in 1.2.0. The same criteria read per discipline a person judges a game by (core/reference/quality-floor.yaml `scorecard`): gameplay, game feel, level design, 2D art, 3D art, UI/UX, audio, performance, technical integrity, accessibility and readability, platform compliance, publishing readiness - each with its own score - and every hard blocker listed on its own. A line with a blocker below its minimum is BELOW_FLOOR whatever it or any other line scores: no average lifts a blocker, and a line BELOW_FLOOR fails the gate. Absent from a report scored on a floor from before the scorecard.",
      "required": [
        "render",
        "lines",
        "hard_blockers"
      ],
      "properties": {
        "render": {
          "enum": [
            "2d",
            "3d"
          ],
          "description": "The rendering dimension the art lines were chosen by."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "score",
              "status",
              "criteria",
              "blockers"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "The line id (gameplay, feel, level_design, art_2d, art_3d, ui_ux, audio, performance, technical, accessibility, platform_compliance, publishing_readiness as shipped)."
              },
              "label": {
                "type": "string"
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The floor dimensions whose criteria the line takes."
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "min_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The line's hard blockers below their minimum (criterion ids)."
              },
              "status": {
                "enum": [
                  "PASS",
                  "BELOW_FLOOR",
                  "UNMEASURED",
                  "DEFERRED",
                  "NOT_APPLICABLE"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "hard_blockers": {
          "type": "array",
          "description": "Every blocker criterion below its minimum or unmeasured, and every open blocker finding not yet re-measured on a newer build - listed apart from any score.",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "line",
              "dimension",
              "status"
            ],
            "properties": {
              "criterion": {
                "type": "string"
              },
              "line": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dimension": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "FAIL",
                  "UNMEASURED",
                  "OPEN"
                ]
              },
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "missing_gates": {
      "type": "array",
      "description": "Added in 1.2.0. Gates the Factory's quality policy requires before this step that the run's own workflow does not have - a run started under an older definition, or a workflow from elsewhere. Named so a person never decides G4 believing they ran; a report naming any is never a release.",
      "items": {
        "type": "object",
        "required": [
          "step"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "lesson_candidates": {
      "type": "array",
      "description": "Added in 1.2.0. Systemic issues specialist visits reported (prototype-report specialist.lesson_candidates, triage-report lesson_candidates), surfaced to the person deciding G4. A candidate is never applied by itself: a person promotes it to core/reference/lessons.yaml, with the check and test that hold it.",
      "items": {
        "$ref": "./shared/quality-finding.schema.json#/$defs/lesson_candidate"
      }
    },
    "ledger": {
      "type": "object",
      "description": "The run's finding ledger as the gate advanced it on this build's reports and its own (scripts/wgf_triage/ledger.py): every finding with its lifecycle, which open ones a gate raised (`open`: they hold the build BLOCKED) and which wait for the person at G4 (`awaiting`). Absent when the gate was blocked before scoring. Added in 1.1.0.",
      "required": [
        "blocking_severities",
        "open",
        "awaiting",
        "lifecycle"
      ],
      "properties": {
        "blocking_severities": {
          "type": "array",
          "items": {
            "$ref": "./shared/quality-finding.schema.json#/$defs/severity"
          }
        },
        "open": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "awaiting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "$ref": "./shared/quality-finding.schema.json#/$defs/record"
          }
        }
      },
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "description": "Added in 1.3.0. Knowledge compliance (scripts/wgf_quality/compliance.py, docs/knowledge-enforcement.md): every rule of the run's knowledge-contract that applies to this title, held to the checks that hold it on this build's current reports (read where check-tiers.yaml `status_at` says). A blocking or required rule FAILED or UNMEASURED and not excepted by a person makes the verdict RELEASE_BLOCKED; `enforcing`, that makes the release decision not-release. `advisory` (a development build, or a run started before the knowledge model, whose rules are resolved now from what it pinned) is shown and changes nothing. Exceptions are listed whatever their status; nothing is skipped silently.",
      "required": [
        "mode",
        "contract",
        "versions",
        "counts",
        "rules",
        "exceptions",
        "regression",
        "lessons_applied",
        "new_lessons",
        "blocking",
        "verdict",
        "holds_release"
      ],
      "properties": {
        "mode": {
          "enum": [
            "enforcing",
            "advisory"
          ]
        },
        "advisory_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract": {
          "type": "object",
          "required": [
            "artifact_id",
            "content_hash",
            "retroactive"
          ],
          "properties": {
            "artifact_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "content_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "retroactive": {
              "type": "boolean",
              "description": "The run made no knowledge-contract: its rules were resolved now from the knowledge it pinned."
            }
          },
          "additionalProperties": false
        },
        "versions": {
          "type": "object",
          "description": "What the rules were resolved from: the contract's `versions` (Factory version and commit, quality policy, benchmark, floor, lessons, check tiers, workflow, platform profiles)."
        },
        "facets": {
          "type": "object",
          "description": "The run's facets the contract was resolved for."
        },
        "counts": {
          "type": "object",
          "required": [
            "by_level",
            "total"
          ],
          "properties": {
            "by_level": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/complianceCount"
              }
            },
            "total": {
              "$ref": "#/$defs/complianceCount"
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "level",
              "status",
              "checks",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9-]*$"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "enum": [
                  "blocking",
                  "required",
                  "recommended",
                  "experimental"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "SATISFIED",
                  "FAILED",
                  "UNMEASURED",
                  "DEFERRED",
                  "NOT_APPLICABLE",
                  "EXCEPTED",
                  "NOT_ENFORCED"
                ]
              },
              "measured_status": {
                "enum": [
                  "FAILED",
                  "UNMEASURED"
                ],
                "description": "An EXCEPTED rule's status before the exception."
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "check",
                    "status",
                    "evidence"
                  ],
                  "properties": {
                    "check": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+:[A-Za-z0-9._*-]+$"
                    },
                    "tier": {
                      "enum": [
                        "hard",
                        "quality",
                        "advisory",
                        null
                      ]
                    },
                    "producer": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "PASS",
                        "FAIL",
                        "UNMEASURED",
                        "DEFERRED",
                        "NOT_APPLICABLE"
                      ]
                    },
                    "results": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "note": {
                      "type": "string"
                    },
                    "evidence": {
                      "$ref": "#/$defs/complianceEvidence"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "exception": {
                "type": "object",
                "properties": {
                  "rule_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scope": {},
                  "approved_by": {},
                  "created_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "gap": {
                "type": "string"
              },
              "blocks": {
                "type": "boolean",
                "description": "A blocking or required rule FAILED or UNMEASURED: it holds the release."
              },
              "warning": {
                "type": "boolean",
                "description": "A recommended or experimental rule not satisfied: reported, never blocking."
              }
            },
            "additionalProperties": false
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "why_not"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "why_not": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "exceptions": {
          "type": "array",
          "description": "Every exception offered for the run - the contract's and those a person granted since - with whether it held at this gate's clock: `honoured`, `expired` (the rule is held again), `refused` (never honoured).",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "status",
              "problems"
            ],
            "properties": {
              "rule_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope": {},
              "approved_by": {},
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "honoured",
                  "expired",
                  "refused"
                ]
              },
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "regression": {
          "type": "object",
          "required": [
            "checks_run",
            "checks_passed",
            "checks_failed",
            "checks_unmeasured",
            "suite"
          ],
          "properties": {
            "checks_run": {
              "type": "integer",
              "minimum": 0
            },
            "checks_passed": {
              "type": "integer",
              "minimum": 0
            },
            "checks_failed": {
              "type": "integer",
              "minimum": 0
            },
            "checks_unmeasured": {
              "type": "integer",
              "minimum": 0
            },
            "suite": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The applicable rules' tests (catches, passes, generalizes): the Factory's regression firewall for this title's rules, run by its CI, not in a game run."
            },
            "suite_run_here": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lessons_applied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every rule the build was held to."
        },
        "new_lessons": {
          "type": "array",
          "items": {
            "$ref": "./shared/quality-finding.schema.json#/$defs/lesson_candidate"
          },
          "description": "The lesson candidates this run surfaced (the report's `lesson_candidates`)."
        },
        "blocking": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The rules that hold the release."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "enum": [
              "design-gap",
              "assets",
              "develop",
              "listing"
            ]
          }
        },
        "problem": {
          "type": "string",
          "description": "Why the run's knowledge could not be read or resolved."
        },
        "contract_missing": {
          "type": "string",
          "description": "A run that recorded its knowledge has no contract here: RELEASE_BLOCKED, never skipped."
        },
        "evaluated_by": {
          "type": "object",
          "description": "The Factory version and commit of the code that ran this evaluation (the quality gate's checkout). `versions` are the contract's - the Factory that resolved the rules; this is the one that judged the build. `wgf knowledge generations` attributes an outcome's Factory code by it.",
          "properties": {
            "version": { "type": ["string", "null"] },
            "commit": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "verdict": {
          "enum": [
            "PASS",
            "RELEASE_BLOCKED"
          ]
        },
        "holds_release": {
          "type": "boolean",
          "description": "Enforcing and RELEASE_BLOCKED: the release decision is not-release because of it."
        }
      },
      "additionalProperties": false
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": false
}
