{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgamefactory.dev/schemas/artifacts/shared/dimension-vocabulary.schema.json",
  "title": "Dimension Vocabulary",
  "description": "Validates core/reference/dimensions.yaml. One shared enumeration of what the factory optimizes for, so a dimension id means the same thing in an evaluation, a scoring model, a kill criterion, and a tech plan.",

  "x-wgf": {
    "id": "dimension-vocabulary",
    "kind": "reference",
    "format": "yaml",
    "instance_path": "core/reference/dimensions.yaml",
    "consumers": ["portfolio:scored", "title:strategy", "title:design", "title:tech-plan", "title:live"]
  },

  "type": "object",
  "required": ["version", "dimensions"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dimension" }
    },
    "groups": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["id", "label", "group", "direction", "unit", "scale", "min_evidence_tier"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "group": {
          "type": "string",
          "enum": ["business", "product", "platform", "engineering", "production"]
        },
        "direction": {
          "type": "string",
          "enum": ["maximize", "minimize"],
          "description": "Which way is good. Normalization inverts for minimize dimensions."
        },
        "unit": { "type": "string" },
        "scale": {
          "type": "string",
          "enum": ["ratio", "ordinal", "currency", "count"]
        },
        "levels": {
          "type": "array",
          "description": "Required for ordinal scales; ordered worst-to-best or as documented on the dimension.",
          "items": { "type": "string" }
        },
        "min_evidence_tier": {
          "type": "string",
          "enum": ["observed", "derived", "hypothesis"],
          "description": "The weakest claim tier acceptable for this dimension. Scoring a dimension below its minimum tier is a finding, not a value."
        },
        "default_source": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "scale": { "const": "ordinal" } }, "required": ["scale"] },
          "then": { "required": ["levels"] }
        }
      ]
    }
  }
}
