{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgamefactory.dev/schemas/artifacts/shared/platform-profile.schema.json",
  "title": "Platform Profile",
  "description": "Validates files in core/reference/platforms/. A platform profile is DATA, not integration code — adding a platform is one new file and zero changes anywhere else, which is what keeps core platform-independent.\n\nProfiles are versioned and read at three points with rising strictness: advisory when scoring an opportunity, binding on the design at strategy/design, and binding on the built package at release validation. Because a release pins the profile version it was built against, a build stays reproducible against the compliance rules that were in force when it shipped.",

  "x-wgf": {
    "id": "platform-profile",
    "kind": "reference",
    "format": "yaml",
    "instance_path": "core/reference/platforms/*.yaml",
    "consumers": ["portfolio:scored", "title:strategy", "title:design", "release:validating", "release:submitting"],
    "updated_by": "platform-publication:rejected"
  },

  "type": "object",
  "required": ["id", "name", "version", "capabilities", "requirements", "ads", "review"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Must match the platform id used in web-game-template/game.config.yaml."
    },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["verified", "unverified", "deprecated"],
      "description": "unverified means the figures have not been checked against the portal's own documentation and should be treated as hypotheses."
    },
    "docs": { "type": ["string", "null"] },

    "audience": {
      "type": "object",
      "properties": {
        "primary_regions": { "type": "array", "items": { "type": "string" } },
        "device_mix": {
          "type": "object",
          "properties": {
            "mobile": { "type": "number", "minimum": 0, "maximum": 1 },
            "desktop": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "capabilities": {
      "type": "object",
      "required": ["ads", "iap"],
      "properties": {
        "ads": {
          "type": "array",
          "items": { "enum": ["interstitial", "rewarded", "banner"] }
        },
        "iap": { "type": "boolean" },
        "cloud_saves": { "type": "boolean" },
        "leaderboards": { "type": "boolean" },
        "achievements": { "type": "boolean" },
        "auth": { "enum": ["required", "optional", "none"] },
        "analytics": { "enum": ["platform-provided", "self-hosted", "none"] }
      },
      "additionalProperties": false
    },

    "requirements": {
      "type": "object",
      "required": ["locales_required"],
      "properties": {
        "locales_required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Binding on the design. Yandex needs ru, GameVui needs vi — discovering this after the build is the expensive path."
        },
        "locales_recommended": { "type": "array", "items": { "type": "string" } },
        "max_bundle_mb": { "type": ["number", "null"] },
        "orientation": { "type": "array", "items": { "enum": ["landscape", "portrait"] } },
        "loading_api": { "enum": ["required", "optional", "none"] },
        "offline_start": { "type": "boolean" },
        "https_only": { "type": "boolean" },
        "external_requests": { "enum": ["allowed", "restricted", "forbidden"] },
        "quality_guidelines": { "enum": ["enforced", "advisory", "none"] },
        "no_external_links": { "type": "boolean" },
        "game_id": {
          "enum": ["required", "optional", "none"],
          "description": "Whether the portal issues a per-title Game ID the build carries as game.config.yaml platforms[].game_id. required: the tech plan cannot target the platform without one, and blocks. optional: the build may take it from its environment instead. none (the meaning when absent): an entry for this platform must not carry one."
        },
        "game_id_pattern": {
          "type": "string",
          "description": "The shape of the portal's Game ID, as a regular expression the whole value must match. Checked when the tech plan takes a registration, long before a build would reject it."
        },
        "hosting": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "minItems": 1,
          "description": "Hosting modes the portal accepts, the first being its default, as game.config.yaml platforms[].hosting spells them. The tech plan writes hosting (and game_url) only for a non-default mode."
        }
      },
      "additionalProperties": false
    },

    "ads": {
      "type": "object",
      "properties": {
        "interstitial_min_interval_s": { "type": ["number", "null"] },
        "rewarded_available": { "type": "boolean" },
        "banner_available": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "metadata_requirements": {
      "type": "object",
      "description": "The coarse store metadata requirements the design and the release read. The store-listing step reads the finer `store_listing` block below, falling back to these.",
      "properties": {
        "descriptions_locales": { "type": "array", "items": { "type": "string" } },
        "screenshots_min": { "type": "integer", "minimum": 0 },
        "icon_required": { "type": "boolean" },
        "age_rating_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "review": {
      "type": "object",
      "required": ["process"],
      "properties": {
        "process": { "enum": ["manual", "automated", "none"] },
        "typical_days": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max]. The factory cannot accelerate moderation; this exists so waiting is visible rather than mistaken for being finished."
        },
        "common_rejections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Appended to whenever a submission is rejected. This is the factory's memory — without it the same wall gets hit by every title."
        }
      },
      "additionalProperties": false
    },

    "assertions": {
      "type": "array",
      "description": "Executed at release:validating against the built package. Every assertion should correspond to a requirement the design was already bound to.",
      "items": {
        "type": "object",
        "required": ["id", "check", "severity"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "check": { "$ref": "https://webgamefactory.dev/schemas/artifacts/shared/criteria-expression.schema.json#/$defs/expression" },
          "severity": { "enum": ["blocking", "warning"] },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "store_listing": { "$ref": "#/$defs/storeListing" },

    "scoring_hints": {
      "type": "object",
      "description": "Advisory input to the platform_fit dimension. Prose on purpose — this informs a judgement, it does not compute one.",
      "properties": {
        "platform_fit_favours": { "type": "array", "items": { "type": "string" } },
        "platform_fit_penalizes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,

  "$defs": {
    "storeListing": {
      "type": "object",
      "description": "What this portal's listing requires, read by the store-listing step (which renders the platform's listing from the canonical package) and by listing validation (core/reference/store-listing.yaml; docs/store-listing-module.md). Every limit may be null: null means NOT KNOWN - validation reports the requirement UNKNOWN and never passes it - so a figure nobody read from the portal's own documentation is never invented here. `status: verified` says every figure in the block was read from `source`.",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["verified", "unverified"], "description": "unverified: the figures are a starting point; treat each as a hypothesis until read from the portal." },
        "source": { "type": ["string", "null"], "description": "Where the figures were read: the portal's developer documentation URL, with the date." },
        "notes": { "type": "string" },
        "title": { "$ref": "#/$defs/textLimit" },
        "subtitle": { "$ref": "#/$defs/textLimit" },
        "short_description": { "$ref": "#/$defs/textLimit" },
        "long_description": { "$ref": "#/$defs/textLimit" },
        "promo": { "$ref": "#/$defs/textLimit" },
        "tags": { "$ref": "#/$defs/listLimit" },
        "categories": { "$ref": "#/$defs/listLimit" },
        "locales": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Locales the listing texts are required in. Null: metadata_requirements.descriptions_locales, then requirements.locales_required."
        },
        "age_rating": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "system": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "icon": { "$ref": "#/$defs/imageRequirement" },
        "covers": {
          "type": "array",
          "description": "Thumbnails, covers, banners, promotional images: one entry per image the portal asks for.",
          "items": { "$ref": "#/$defs/imageRequirement" }
        },
        "screenshots": {
          "type": "object",
          "properties": {
            "required": { "type": ["boolean", "null"] },
            "min": { "type": ["integer", "null"], "minimum": 0 },
            "max": { "type": ["integer", "null"], "minimum": 1 },
            "sizes": { "type": ["array", "null"], "items": { "$ref": "#/$defs/size" }, "description": "Accepted exact sizes; null: any size of the stated aspect." },
            "aspect": { "type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$" },
            "formats": { "type": ["array", "null"], "items": { "enum": ["png", "jpg", "webp", "gif"] } },
            "max_kb": { "type": ["integer", "null"], "minimum": 1 },
            "orientation": { "type": ["array", "null"], "items": { "enum": ["landscape", "portrait"] } }
          },
          "additionalProperties": false
        },
        "video": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "formats": { "type": ["array", "null"], "items": { "enum": ["webm", "mp4", "mov", "gif"] } },
            "min_seconds": { "type": ["number", "null"], "minimum": 0 },
            "max_seconds": { "type": ["number", "null"], "minimum": 0 },
            "max_mb": { "type": ["number", "null"], "minimum": 0 },
            "min_width": { "type": ["integer", "null"], "minimum": 1 },
            "min_height": { "type": ["integer", "null"], "minimum": 1 },
            "aspect": { "type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$" },
            "hosted": { "type": ["string", "null"], "description": "Where the portal wants the video: `upload`, or a video host's name when it takes only a link." }
          },
          "additionalProperties": false
        },
        "naming": {
          "type": "object",
          "properties": {
            "files": { "type": ["string", "null"], "description": "A regular expression file names must match, when the portal requires one." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "textLimit": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "min_chars": { "type": ["integer", "null"], "minimum": 0 },
        "max_chars": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "listLimit": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "min": { "type": ["integer", "null"], "minimum": 0 },
        "max": { "type": ["integer", "null"], "minimum": 1 },
        "allowed": { "type": ["array", "null"], "items": { "type": "string" }, "description": "The portal's own vocabulary, when it has one; null: free text." },
        "max_chars": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "imageRequirement": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "label": { "type": "string" },
        "required": { "type": ["boolean", "null"], "description": "null: not known whether the portal requires it." },
        "sizes": { "type": ["array", "null"], "items": { "$ref": "#/$defs/size" }, "description": "Accepted exact sizes, the first preferred; null: not known." },
        "aspect": { "type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$" },
        "formats": { "type": ["array", "null"], "items": { "enum": ["png", "jpg", "webp", "gif", "svg"] } },
        "max_kb": { "type": ["integer", "null"], "minimum": 1 },
        "transparent": { "type": ["boolean", "null"] },
        "source": { "enum": ["icon", "thumbnail", "promo", "logo", "screenshot"], "description": "Which canonical rendition family the image is rendered from (core/reference/store-listing.yaml renditions)." }
      },
      "additionalProperties": false
    }
  }
}
