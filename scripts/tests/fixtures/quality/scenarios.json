{
  "_comment": "The quality-consistency suite's scenarios (scripts/tests/test_quality_consistency.py, docs/quality-consistency-tests.md). `genres`: one representative game per kind the Factory must hold to the same floor. `degradations`: one defect each, put into a production build that is otherwise release quality; `gate` is the step expected to detect it, `report` the artifact it writes, `expect` the check, finding or criterion ids it must name (substrings), `label` the route triage (or the gate itself, for `assets`) must send it to, and `owner` the specialist its finding names when that is not the label (an asset made again is the assets step's work, owned by the discipline), as core/reference/specialist-routing.yaml assigns them. `fix` is the label whose visit removes it in the recovery tests.",
  "genres": [
    {"id": "arcade-2d", "family": "arcade", "dimension": "2d",
     "why": "a 2D arcade game: endless, one verb, a score to beat"},
    {"id": "racing-3d", "family": "racing", "dimension": "3d",
     "why": "a 3D game with mechanics of another kind: a chase camera, laps, rivals and a clock"},
    {"id": "puzzle-casual", "family": "puzzle", "dimension": "2d",
     "why": "the simple genre: a casual level puzzle, whose own family bar (20 levels) is above the benchmark's"},
    {"id": "platformer-content", "family": "platformer", "dimension": "2d",
     "why": "a content-heavy genre: levels in worlds, hazards and traversal elements"},
    {"id": "strategy-content", "family": "strategy", "dimension": "2d",
     "why": "a content-heavy genre of another shape: maps in regions, towers against waves, a gold economy"},
    {"id": "simulation-systems", "family": "simulation", "dimension": "2d",
     "why": "different mechanics again: a management loop whose loss is a resource running out"}
  ],
  "degradations": [
    {"id": "remove-content", "n": 1, "genre": "platformer-content", "defect": "remove-content",
     "gate": "content-sufficiency", "report": "content-sufficiency-report",
     "expect": ["content.units_shipped"], "label": "level-designer"},
    {"id": "reduce-variety-built", "n": 2, "genre": "puzzle-casual", "defect": "reduce-variety",
     "gate": "content-sufficiency", "report": "content-sufficiency-report",
     "expect": ["content.elements", "content.combinations"], "label": "level-designer"},
    {"id": "reduce-variety-played", "n": 2, "genre": "arcade-2d", "defect": "reduce-variety",
     "gate": "playability", "report": "playability-report",
     "expect": ["content.variety"], "label": "level-designer"},
    {"id": "broken-mobile-layout", "n": 3, "genre": "puzzle-casual",
     "defect": "broken-mobile-layout", "gate": "production-quality",
     "report": "production-quality-report",
     "expect": ["mobile:ui.targets", "mobile:ui.overlap"], "label": "ui"},
    {"id": "severe-visual-defect-3d", "n": 4, "genre": "racing-3d",
     "defect": "severe-visual-defect", "gate": "visual-qa", "report": "visual-qa-report",
     "expect": ["finding:cropped-", "score:composition"], "label": "environment-artist"},
    {"id": "severe-visual-defect-2d", "n": 4, "genre": "arcade-2d",
     "defect": "severe-visual-defect", "gate": "visual-qa", "report": "visual-qa-report",
     "expect": ["finding:cropped-", "score:composition"], "label": "artist-2d"},
    {"id": "remove-progression", "n": 5, "genre": "simulation-systems",
     "defect": "remove-progression", "gate": "playability", "report": "playability-report",
     "expect": ["progression.persists"], "label": "systems-designer"},
    {"id": "placeholder-assets", "n": 6, "genre": "arcade-2d", "defect": "placeholder-assets",
     "gate": "production-quality", "report": "production-quality-report",
     "expect": ["assets.present"], "label": "assets"},
    {"id": "broken-win-lose", "n": 7, "genre": "strategy-content", "defect": "broken-win-lose",
     "gate": "playability", "report": "playability-report",
     "expect": ["win.reachable", "lose.reachable"], "label": "gameplay"},
    {"id": "performance-regression", "n": 8, "genre": "racing-3d",
     "defect": "performance-regression", "gate": "quality-gate", "report": "quality-report",
     "expect": ["floor.performance"], "label": "gameplay"},
    {"id": "duplicate-level", "n": 9, "genre": "platformer-content", "defect": "duplicate-level",
     "gate": "content-sufficiency", "report": "content-sufficiency-report",
     "expect": ["content.structure"], "label": "level-designer"},
    {"id": "one-dimension-below-floor", "n": 10, "genre": "simulation-systems",
     "defect": "thin-audio", "gate": "quality-gate", "report": "quality-report",
     "expect": ["floor.sfx"], "label": "assets", "owner": "audio-designer"},
    {"id": "store-copy-overclaims", "n": 11, "genre": "platformer-content",
     "defect": "copy-overclaims", "gate": "listing-validation",
     "report": "listing-validation-report", "expect": ["grounding.counts.en"],
     "label": "listing", "owner": "copywriter"},
    {"id": "flat-progression", "n": 12, "genre": "simulation-systems",
     "defect": "flat-progression", "gate": "content-sufficiency",
     "report": "content-sufficiency-report", "expect": ["content.progression"],
     "label": "systems-designer"}
  ]
}
